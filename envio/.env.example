# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Archive RPC for Vault getter reads and Clock block timestamps (comma-separated
# for fallbacks). Defaults to public endpoints when unset.
# ENVIO_RPC_URL=https://your-archive-rpc
# Optional: stop at a fixed block (used for parity runs).
# ENVIO_END_BLOCK=
