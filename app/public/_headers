# Applied by Workers Static Assets to the dashboard files (not to Worker /api responses).
# The Cloudflare Web Analytics beacon is injected by the zone and reports to /cdn-cgi/rum.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
